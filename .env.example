# 是否使用 Mock 模式
# true：使用模拟回答，不调用真实 API
# false：调用硅基流动真实 API
USE_MOCK=true

# 生成模型后端
# mock：本地模拟回答
# api：SiliconFlow / DeepSeek API baseline
# local_sft：OpenAI-compatible 本地/云端 SFT 模型服务
GENERATION_BACKEND=mock

# 硅基流动 API Key
SILICONFLOW_API_KEY=your_api_key_here

# 硅基流动 API Base URL
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# 生成式大模型
CHAT_MODEL=deepseek-ai/DeepSeek-V3

# 后续云端微调模型服务
# LLaMA Factory API 默认暴露的模型名通常是 gpt-3.5-turbo；
# 若自行改过 API config，再同步改成实际 /v1/models 返回的 id。
LOCAL_SFT_MODEL=gpt-3.5-turbo
LOCAL_SFT_BASE_URL=http://127.0.0.1:8001/v1/chat/completions
LOCAL_SFT_API_KEY=EMPTY
LOCAL_SFT_TEMPERATURE=0.2
LOCAL_SFT_TOP_P=0.8
LOCAL_SFT_MAX_TOKENS=512
LOCAL_SFT_TIMEOUT_SECONDS=120
LOCAL_SFT_REPETITION_PENALTY=1.1

# 本机有代理时，避免 localhost 请求被转发到代理导致隧道访问失败
NO_PROXY=127.0.0.1,localhost
no_proxy=127.0.0.1,localhost

# Embedding 向量模型
EMBEDDING_MODEL=BAAI/bge-m3

# Rerank 重排序模型
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# Redis 运行时控制
# Docker Compose 下会自动覆盖为 redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0
AGENT_CACHE_TTL_SECONDS=300
AGENT_RATE_LIMIT_PER_MINUTE=20
