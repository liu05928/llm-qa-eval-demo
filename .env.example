# 是否使用 Mock 模式
# true：使用模拟回答，不调用真实 API
# false：调用真实大模型 API
USE_MOCK=true

# 硅基流动 API Key
# 使用真实 API 时，请替换成自己的 API Key
DEEPSEEK_API_KEY=your_siliconflow_api_key_here

# 硅基流动 OpenAI 兼容 Chat Completions 地址
DEEPSEEK_BASE_URL=https://api.siliconflow.cn/v1/chat/completions

# 硅基流动平台上的 DeepSeek 模型名称
DEEPSEEK_MODEL=deepseek-ai/DeepSeek-V3